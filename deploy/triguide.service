[Unit]
Description=TriGuide API — Docker Compose Stack (self-hosted)
Documentation=https://github.com/jfemiani10/triguide
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/jonahhome/projects/triguide
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300
TimeoutStopSec=60
Restart=no

Environment="DOCKER_CONFIG=/home/jonahhome/.docker"

[Install]
WantedBy=multi-user.target
