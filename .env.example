# Backend (server/.env) — do not commit real values
ANTHROPIC_API_KEY=
JWT_SECRET=
# Container path when running under docker compose; ./data/triguide.db when running bare
DATABASE_URL=/app/data/triguide.db
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=https://triguide.vercel.app,http://localhost:5173
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://jfhome.tail59a720.ts.net/strava/callback

# Frontend (Vercel project env / client/.env.local)
VITE_API_URL=https://jfhome.tail59a720.ts.net
